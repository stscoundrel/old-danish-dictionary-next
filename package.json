{
  "name": "old-danish-dictionary-next",
  "description": "Next.js implementation of Otto Kalkars Dictionary of Old Danish",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/stscoundrel/old-danish-dictionary-next.git",
  "author": "stscoundrel <silvennoinen.sampo@gmail.com>",
  "licenses": [
    {
      "type": "MIT",
      "url": "http://opensource.org/licenses/MIT"
    }
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "prettier src tests --check",
    "fix": "prettier src tests --write",
    "jest": "jest --verbose --passWithNoTests",
    "test:unit": "yarn jest",
    "test:coverage": "jest --coverage tests src/components --coverageThreshold='{\"global\":{\"statements\":\"90\", \"functions\":\"85\", \"branches\":\"75\", \"lines\":\"90\"}}'",
    "create:alphabet": "ts-node scripts/output-alphabet.ts",
    "revalidate": "ts-node scripts/revalidate.ts"
  },
  "dependencies": {
    "abbreviatrix": "^1.0.8",
    "futhork": "^1.1.9",
    "markari": "^1.0.7",
    "next": "^16.2.11",
    "next-pwa": "^5.6.0",
    "old-danish-dictionary": "^0.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reset-css": "^5.0.2",
    "sass": "^1.98.0",
    "scandinavian-dictionary-crosslinker": "^0.7.0",
    "sharp": "^0.35.4",
    "sitemap": "^7.1.1",
    "slugify": "^1.6.9",
    "teljari": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.24",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "next-router-mock": "^0.9.13",
    "node-mocks-http": "^1.17.2",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.1.0"
}
